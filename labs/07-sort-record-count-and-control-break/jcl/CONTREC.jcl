//CONTREC JOB (ACCT),'COUNT RECORDS',CLASS=A,MSGCLASS=X
//*
//* CUENTA REGISTROS DEL ARCHIVO CLIENTE
//* UTILITARIO: SORT
//* ENTRADA : IBMUSER.COBOL.FILE80(CLIENTE)
//* SALIDA  : SYSOUT CON NUMERO DE REGISTROS
//*
//STEP01  EXEC PGM=SORT
//SYSOUT  DD SYSOUT=*
//SORTIN  DD DSN=IBMUSER.COBOL.FILE80(CLIENTE),DISP=SHR
//SORTOUT DD SYSOUT=*
//SYSIN   DD *
  OPTION COPY
  OUTFIL REMOVECC,NODETAIL,
         TRAILER1=('NUMERO DE REGISTROS: ',COUNT=(M11,LENGTH=8))
/*
//
