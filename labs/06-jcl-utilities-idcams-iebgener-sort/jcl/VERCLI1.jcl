//VERCLI1 JOB (ACCT),'VERIFY CLIENTE',CLASS=A,MSGCLASS=X
//*
//* VERIFICA LA LIBRERIA FILE80 Y EL MIEMBRO CLIENTE1
//* UTILITARIOS: IDCAMS + IEBGENER
//*
//CHKCAT  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENT('IBMUSER.COBOL.FILE80') ALL
/*
//*
//CHKMBR  EXEC PGM=IEBGENER,COND=(0,NE,CHKCAT)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=IBMUSER.COBOL.FILE80(CLIENTE1),DISP=SHR
//SYSUT2   DD DUMMY
//SYSIN    DD DUMMY
//*
//         IF (CHKMBR.RC = 0) THEN
//MSGOK    EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD *
EL ARCHIVO IBMUSER.COBOL.FILE80(CLIENTE1) EXISTE Y ES LEGIBLE
/*
//SYSUT2   DD SYSOUT=*
//SYSIN    DD DUMMY
//         ENDIF
//
